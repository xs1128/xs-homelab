      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom" },
          "expr": "max by (device_id) (mac_power_total_watts{device_id=\"mini\"})",
          "legendFormat": "Total",
          "refId": "A"
        }
      ],
      "description": "Estimated system power: SoC package power plus a fixed 3.8 W allowance for PSU losses, memory, storage, networking, and cooling.",
      "title": "Estimated Power",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prom" },
      "description": "MODELED = CPU-utilization model because powermetrics permission is unavailable. LIVE = powermetrics package readings. The exporter retries LIVE mode every 60 seconds.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": { "0": { "text": "MODELED" }, "1": { "text": "LIVE" } },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#EAB839", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom" },
          "expr": "max(mac_power_source{device_id=\"mini\", source=\"powermetrics\"}) or vector(0)",
          "legendFormat": "Mode",
          "refId": "A"
        }
      ],
      "title": "Power Source",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prom" },
      "description": "SoC package power. Modeled from CPU utilization in MODELED mode; read from powermetrics in LIVE mode.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "watt"
        },
        "overrides": []
